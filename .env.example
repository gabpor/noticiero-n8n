# Copia este archivo como .env y rellénalo. El .env no se sube nunca al repositorio.
# n8n no lee estas claves en tiempo de ejecución: scripts/importar.sh las guarda
# como credenciales cifradas dentro de n8n y los workflows solo llevan la referencia.

# Contraseña de PostgreSQL (invéntala, mínimo 16 caracteres)
POSTGRES_PASSWORD=

# Clave de la API de Gemini: aistudio.google.com → Get API key
GEMINI_API_KEY=

# Clave de la API de Groq (modelo de reserva): console.groq.com → API Keys
GROQ_API_KEY=

# Token del bot de Telegram: @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
